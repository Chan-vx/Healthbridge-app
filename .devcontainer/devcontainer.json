{
  // GitHub Codespaces: builds and starts the whole app (PostgreSQL, FastAPI, Next.js)
  // with Docker Compose, then opens the website on port 3000.
  // The "universal" image already includes Docker, so nothing extra has to install.
  "name": "HealthBridge",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": {
    "cpus": 2
  },
  "postCreateCommand": "docker compose up -d --build",
  "postStartCommand": "docker compose up -d",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "HealthBridge website", "onAutoForward": "openBrowser" },
    "8000": { "label": "HealthBridge API", "onAutoForward": "silent" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  }
}
